# ─── Banco ────────────────────────────────────────────────
DATABASE_URL=postgresql://advlink:advlink@localhost:5432/advlink

# ─── Domínio / URLs ───────────────────────────────────────
# Domínio raiz dos perfis públicos (<slug>.ROOT_DOMAIN). Local: localhost:3000
ROOT_DOMAIN=advlink.site
# Igual a ROOT_DOMAIN; exposto ao navegador (embutido no build — defina também como build arg)
NEXT_PUBLIC_ROOT_DOMAIN=advlink.site
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# ─── NextAuth ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Admin interno (/admin) ───────────────────────────────
ADMIN_JWT_SECRET=               # obrigatório em produção — openssl rand -base64 32

# ─── E-mail ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@advlink.site
# SMTP (magic link via nodemailer). Local: Mailpit em 127.0.0.1:1025
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# ─── Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=              # sk_test_... localmente
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=          # whsec_... (stripe listen mostra o local)

# ─── AWS S3 (uploads) ─────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ─── OpenAI (descrição de áreas) ──────────────────────────
OPENAI_API_KEY=

# ─── Tracking ─────────────────────────────────────────────
NEXT_PUBLIC_FB_PIXEL_ID=
