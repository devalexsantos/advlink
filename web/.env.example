# ─── Banco ────────────────────────────────────────────────
DATABASE_URL=postgresql://advlink:advlink@localhost:5432/advlink
# Banco descartável para os testes de integração do billing (crie e rode `prisma migrate deploy` nele)
DATABASE_URL_TEST=postgresql://advlink:advlink@localhost:5432/advlink_test

# ─── Domínio / URLs ───────────────────────────────────────
# Domínio raiz dos perfis públicos (<slug>.ROOT_DOMAIN). Local: localhost:3000
ROOT_DOMAIN=advlink.site
# Igual a ROOT_DOMAIN; exposto ao navegador (embutido no build — defina também como build arg)
NEXT_PUBLIC_ROOT_DOMAIN=advlink.site
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# Dev only: comma-separated hosts (e.g. a trycloudflare tunnel) allowed to load Next dev resources
DEV_ALLOWED_ORIGINS=

# ─── NextAuth ─────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                # openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Admin interno (/admin) ───────────────────────────────
ADMIN_JWT_SECRET=               # obrigatório em produção — openssl rand -base64 32

# ─── E-mail ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@advlink.site   # (o remetente efetivo vem de lib/resend.ts; domínio precisa estar verificado na Resend)
# Magic link de login: produção SEMPRE via Resend. Em dev vai para o Mailpit local
# (127.0.0.1:1025, docker run -p 1025:1025 -p 8025:8025 axllent/mailpit). Para forçar
# envio real via Resend em dev, use EMAIL_DEV_TRANSPORT=resend (usa a RESEND_API_KEY).
EMAIL_DEV_TRANSPORT=

# ─── Asaas (cobrança) ─────────────────────────────────────
# Sandbox: https://api-sandbox.asaas.com/v3 + chave $aact_hmlg_... | Produção: https://api.asaas.com/v3 + chave $aact_prod_...
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token que o Asaas envia no header asaas-access-token (>= 32 chars): openssl rand -hex 32
ASAAS_WEBHOOK_AUTH_TOKEN=
# Usado só pelo scripts/asaas/register-webhook.ts (alertas de falha do webhook)
ASAAS_WEBHOOK_ALERT_EMAIL=
# Bearer do /api/cron/billing-sweep (>= 32 chars), o mesmo do secret CRON_SECRET no GitHub
CRON_SECRET=
# Destino do aviso interno de cancelamento de assinatura (padrão: advlinkcontato@gmail.com)
BILLING_TEAM_EMAIL=

# ─── E-mails de ativação (drip) ───────────────────────────
# Segredo (>= 32 chars) que assina os links de descadastro: openssl rand -hex 32
EMAIL_UNSUBSCRIBE_SECRET=
# Só contas criadas a partir deste instante (ISO, ex.: 2026-10-12T00:00:00Z) recebem o drip.
# Sem ele nada é enviado. Cron: /api/cron/activation-emails (mesmo CRON_SECRET)
ACTIVATION_DRIP_START=

# ─── AWS S3 (uploads) ─────────────────────────────────────
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ─── OpenAI (descrição de áreas) ──────────────────────────
OPENAI_API_KEY=

# ─── Tracking ─────────────────────────────────────────────
NEXT_PUBLIC_FB_PIXEL_ID=
