// Prisma schema for NextAuth (with passwordHash support for Credentials provider)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(cuid())
  name                    String?
  email                   String?   @unique
  emailVerified           DateTime?
  image                   String?
  isActive                Boolean   @default(true)
  passwordHash            String?
  completed_onboarding    Boolean   @default(false) @map("completed_onboarding")
  // Opt-out of activation/tips e-mails (account and billing e-mails are not affected).
  marketingEmailsOptOutAt DateTime?

  accounts Account[]
  sessions Session[]
  profiles Profile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets        Ticket[]
  ticketMessages TicketMessage[]
  emailSends     EmailSend[]
}

// One row per lifecycle e-mail sent to a user (idempotency of the activation drip).
model EmailSend {
  id     String   @id @default(cuid())
  userId String
  kind   String
  siteId String?
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String?
  setupComplete Boolean @default(false)
  isActive      Boolean @default(false)

  // Billing (Asaas). isActive = published = billing ACTIVE|GRACE && !suspendedByAdmin (lib/billing).
  billingStatus    BillingStatus @default(NONE)
  /// Last day covered by paid charges (civil date, America/Sao_Paulo)
  paidUntil        DateTime?     @db.Date
  /// Last day of the grace period after paidUntil
  graceUntil       DateTime?     @db.Date
  /// Admin block, independent from billing (webhook never undoes it)
  suspendedByAdmin Boolean       @default(false)
  /// Set when the subscription was ended for non-payment (30 days suspended)
  churnedAt        DateTime?

  headline           String?
  avatarUrl          String?
  whatsapp           String?
  whatsappIsFixed    Boolean @default(true)
  instagramUrl       String?
  publicName         String?
  aboutDescription   String?
  publicEmail        String?
  publicPhone        String?
  publicPhoneIsFixed Boolean @default(false)
  slug               String? @unique
  primaryColor       String  @default("#000e29")
  secondaryColor     String  @default("#e8e8e8")
  textColor          String  @default("#FFFFFF")
  coverUrl           String? @default("https://advoga-site.s3.us-east-2.amazonaws.com/covers/covers_cmehhui1b000adp8wog0ziszn.1755786112784_tiny.png")
  calendlyUrl        String?
  metaDescription    String?
  metaTitle          String?
  keywords           String?
  gtmContainerId     String?
  theme              String? @default("classic")
  sectionOrder       Json?
  sectionLabels      Json?
  sectionIcons       Json?
  sectionTitleHidden Json?

  /// OAB registration of the site's lawyer (digits + optional 1-letter suffix, normalized by lib/oab)
  oabNumber        String?
  /// UF of the OAB registration (e.g. "SP")
  oabState         String?
  /// "autonomo" | "escritorio"
  practiceType     String?
  /// First time the site became published (set once by recomputeProfile)
  firstPublishedAt DateTime?

  linkedinUrl     String?
  facebookUrl     String?
  youtubeUrl      String?
  /// Default text of the site's WhatsApp links (wa.me ?text=)
  whatsappMessage String?

  /// Law firm (sociedade de advocacia) shown in the footer: "individual" | "sociedade"
  firmName            String?
  firmType            String?
  firmOabRegistration String?
  /// Digits only
  firmCnpj            String?

  /// Free text, e.g. "Seg. a sex., 9h às 18h"
  officeHours   String?
  /// Free text, e.g. "Português, Inglês"
  languages     String?
  onlineService Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pageViews      PageView[]
  contactClicks  ContactClick[]
  activityAreas  ActivityAreas[]
  links          Links[]
  gallery        Gallery[]
  address        Address?
  customSections CustomSection[]
  teamMembers    TeamMember[]
  previewLinks   PreviewLink[]

  billingPaymentLinks  BillingPaymentLink[]
  billingSubscriptions BillingSubscription[]
  billingPayments      BillingPayment[]

  @@index([userId])
  @@index([billingStatus])
}

model PageView {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  path        String   @default("/")
  referrer    String?
  userAgent   String?  @map("user_agent")
  country     String?
  city        String?
  region      String?
  deviceType  String?  @map("device_type")
  browser     String?
  visitorHash String?  @map("visitor_hash")
  createdAt   DateTime @default(now())

  @@index([profileId, createdAt])
  @@index([profileId, visitorHash, createdAt])
}

/// Clique em botão de contato do site público (WhatsApp, telefone, e-mail, link externo).
/// LGPD: só alimenta contagens agregadas. Não guarda telefone, URL de destino nem IP;
/// visitorHash é o mesmo hash diário truncado do PageView, usado apenas para deduplicar.
model ContactClick {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  /// "whatsapp" | "phone" | "email" | "link"
  kind        String
  visitorHash String   @map("visitor_hash")
  createdAt   DateTime @default(now())

  @@index([profileId, createdAt])
}

model ActivityAreas {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title         String
  coverImageUrl String?
  description   String?
  position      Int
  faqs          ActivityAreaFaq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, position], map: "ActivityAreas_profileId_position_idx")
}

/// Informative Q&A of a practice area (plain text), rendered in the public "faq" section
model ActivityAreaFaq {
  id       String        @id @default(cuid())
  areaId   String
  area     ActivityAreas @relation(fields: [areaId], references: [id], onDelete: Cascade)
  question String
  answer   String
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, position])
}

model Links {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  url           String
  coverImageUrl String?
  position      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Gallery {
  id        String  @id @default(cuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  coverImageUrl String?
  position      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id           String  @id @default(cuid())
  profileId    String  @unique
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  public       Boolean @default(true)
  zipCode      String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
}

model AdminUser {
  id              String          @id @default(cuid())
  email           String          @unique
  name            String?
  passwordHash    String
  role            String          @default("admin") // "admin" | "super_admin"
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assignedTickets Ticket[]        @relation("AssignedAdmin")
  ticketMessages  TicketMessage[] @relation("AdminSender")
  auditLogs       AuditLog[]
}

model Ticket {
  id              String          @id @default(cuid())
  number          Int             @unique @default(autoincrement())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId          String?
  subject         String
  status          String          @default("open") // open|in_progress|waiting_customer|resolved|closed
  priority        String          @default("medium") // low|medium|high
  category        String          @default("support") // support|billing|bug|feature_request
  assignedAdminId String?
  assignedAdmin   AdminUser?      @relation("AssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  messages        TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedAdminId])
}

model TicketMessage {
  id            String     @id @default(cuid())
  ticketId      String
  ticket        Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType    String // "user" | "admin"
  senderUserId  String?
  senderUser    User?      @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  senderAdminId String?
  senderAdmin   AdminUser? @relation("AdminSender", fields: [senderAdminId], references: [id], onDelete: SetNull)
  message       String
  imageUrls     Json?
  createdAt     DateTime   @default(now())

  @@index([ticketId, createdAt])
}

model ProductEvent {
  id        String   @id @default(cuid())
  userId    String?
  siteId    String?
  type      String
  metaJson  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId])
}

model AuditLog {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model TeamMember {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  description String?
  avatarUrl   String?
  phone       String?
  whatsapp    String?
  email       String?
  oabNumber   String?
  oabState    String?
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([profileId, position])
}

/// Shareable, expiring link to preview an unpublished site (/previa/[token])
model PreviewLink {
  id        String   @id @default(cuid())
  token     String   @unique
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([profileId])
}

model CustomSection {
  id           String   @id @default(cuid())
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  imageUrl     String?
  layout       String // "image-left" | "image-right" | "text-only" | "video" | "button"
  iconName     String   @default("FileText")
  position     Int
  videoUrl     String?
  buttonConfig Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([profileId, position])
}

// ─── Billing (Asaas) ─────────────────────────────────────────
// Local mirror of the Asaas state. The webhook only tells what to fetch; lib/billing re-fetches
// payments/subscriptions and recomputes Profile.billingStatus (order-independent, idempotent).

enum BillingStatus {
  NONE // never subscribed
  PENDING // checkout started, nothing paid yet
  ACTIVE // paid period running
  GRACE // paid period over, inside the grace days (still published)
  SUSPENDED // overdue after grace: unpublished, subscription still open
  CANCELED // subscription ended (by the lawyer or after 30 days suspended)
}

model BillingPaymentLink {
  id          String    @id @default(cuid())
  environment String // SANDBOX | PRODUCTION
  asaasId     String
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  billingType String // UNDEFINED (card + boleto) | PIX
  url         String
  status      String    @default("ACTIVE") // ACTIVE | CONSUMED | DISABLED
  createdAt   DateTime  @default(now())
  closedAt    DateTime?

  @@unique([environment, asaasId])
  @@index([profileId, status])
}

model BillingSubscription {
  id              String    @id @default(cuid())
  environment     String
  asaasId         String
  profileId       String
  profile         Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  asaasCustomerId String
  billingType     String?
  valueCents      Int
  status          String // ACTIVE | INACTIVE | EXPIRED | DELETED (Asaas status, DELETED when deleted)
  nextDueDate     String? // YYYY-MM-DD
  cancelReason    String?
  canceledAt      DateTime?
  syncedAt        DateTime  @default(now())
  createdAt       DateTime  @default(now())

  @@unique([environment, asaasId])
  @@index([profileId, status])
}

model BillingPayment {
  id                  String   @id @default(cuid())
  environment         String
  asaasId             String
  profileId           String
  profile             Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  subscriptionAsaasId String?
  billingType         String
  valueCents          Int
  netValueCents       Int?
  status              String // Asaas payment status (PENDING, CONFIRMED, RECEIVED, OVERDUE, REFUNDED...)
  dueDate             String // YYYY-MM-DD
  paymentDate         String? // YYYY-MM-DD
  /// Refunded, charged back or deleted: covers nothing
  revoked             Boolean  @default(false)
  invoiceUrl          String?
  syncedAt            DateTime @default(now())
  createdAt           DateTime @default(now())

  @@unique([environment, asaasId])
  @@index([profileId, dueDate])
}

/// Every webhook delivery, deduplicated by (provider, environment, eventId). Unprocessed rows are
/// retried by the billing sweep, so the webhook can always answer 200 quickly.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("ASAAS")
  environment String
  eventId     String
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  result      String?
  error       String?
  attempts    Int       @default(0)

  @@unique([provider, environment, eventId])
  @@index([processedAt])
}
